{
  "name": "@acme/client",
  "version": "0.3.0",
  "description": "TypeScript client for the ACME arena (live-race rooms, prize cups) and house (treasury split, prize vault, upgrade shop) programs",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "idl": "node scripts/copy-idl.mjs",
    "build": "rm -rf dist && npm run idl && tsc -p tsconfig.json",
    "pack": "npm run build && npm pack"
  },
  "peerDependencies": {
    "@anchor-lang/core": "1.1.2",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.1.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0",
    "@types/bn.js": "^5.1.0",
    "typescript": "^5.7.3"
  }
}
